configuration {
    modi: "run,drun,window";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: " 󰕰  Window ";
    sidebar-mode: true;
}

* {
    bg:       #121212; 
    bg-sel:   #1e2b22; 
    fg:       #e0e0e0; 
    accent:   #4a8c5b; 
    font:     "Maple Mono 12";
}

window {
    width: 35%;
    transparency: "real";
    orientation: vertical;
    cursor: "default";
    spacing: 0px;
    border: 2px solid;
    border-color: @accent;
    border-radius: 10px;
    background-color: @bg;
}

mainbox {
    padding: 15px;
    enabled: true;
    spacing: 0px;
    orientation: vertical;
    children: [ "inputbar", "listview" ];
    background-color: transparent;
}

inputbar {
    padding: 10px;
    margin: 0px 0px 10px 0px;
    background-color: transparent; 
    children: [ "prompt", "entry" ];
}

/* Make the "Apps" prompt pop using the accent color */
prompt {
    text-color: @accent;
    font: "Maple Mono Bold 12";
    padding: 0px 10px 0px 0px;
}

/* Make the text you type bright and readable */
entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: #555555;
}

listview {
    columns: 1;
    lines: 8;
    spacing: 5px;
    layout: vertical;
    background-color: transparent;
}

element {
    padding: 8px;
    spacing: 10px;
    border-radius: 5px;
    background-color: transparent;
    text-color: @fg;               
}

/* Force normal and alternating rows to be transparent, killing the white boxes */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-sel;
    text-color: @accent;
}

/* Ensure the text and icons inherit the background so they don't draw white squares */
element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 24px;
}
