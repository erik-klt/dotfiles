{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch_small",
    // Das ist der Magie-Teil: Er zwingt das Logo in dein Sands-Gold
    "color": {
      "1": "magenta", // Wir tricksen hier ein bisschen, Pywal mappt das später auf Gold!
      "2": "yellow"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "yellow" // Auch hier: Das wird dein Gold sein
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS   "
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "wm",
      "key": "WM   "
    },
    {
      "type": "terminal",
      "key": "Term "
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "memory",
      "key": "RAM  "
    },
    "break",
    "colors"
  ]
}
