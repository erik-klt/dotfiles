{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/erik/.config/fastfetch/fsociety.txt",
        "type": "auto",
        "width": 28,
        "height": 12,
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "green"
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user": "green",
                "at": "white",
                "host": "yellow"
            }
        },
        {
            "type": "os",
            "key": "󰣇 ",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "󰒋 ",
            "keyColor": "magenta"
        },
        {
            "type": "uptime",
            "key": "󰅐 ",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "󱂬 ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "cyan"
        },
        {
            "type": "battery",
            "key": "󰁹 ",
            "keyColor": "red"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
