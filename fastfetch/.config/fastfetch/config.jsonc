{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/erik/Downloads/dd.jpg",
        "type": "kitty",
        "width": 28,
        "height": 12,
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta"
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user": "red",
                "at": "white",
                "host": "red"
            }
        },
        {
            "type": "os",
            "key": "󰣇 ",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "󰒋 ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "󱂬 ",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
